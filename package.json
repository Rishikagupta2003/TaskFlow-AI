{
  "name": "task-flow-ai-monorepo",
  "version": "0.0.1",
  "description": "TaskFlow AI Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@taskflow/web",
    "dev:gateway": "npm run start:dev --workspace=@taskflow/api-gateway",
    "dev:identity": "npm run start:dev --workspace=@taskflow/identity-service",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
